generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ======================= ENUMS =======================
enum UserRole {
  SUPER_ADMIN
  FACTORY_MANAGER
  WAREHOUSE_MANAGER
  HR_ACCOUNTS
  RSM
}

enum POStatus {
  DRAFT
  PENDING
  APPROVED
  RECEIVED
  PARTIAL
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  APPROVED
  DELIVERED
  RETURNED
  CANCELLED
}

enum StockMoveType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN
  PRODUCTION
}

enum QAResult {
  PASS
  FAIL
  PARTIAL
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  MIXING
  PACKING
  COMPLETED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JVType {
  PAYMENT
  RECEIPT
  JOURNAL
  CONTRA
  BANK
}

enum JVStatus {
  DRAFT
  POSTED
  REVERSED
}

enum EmpStatus {
  ACTIVE
  RESIGNED
  TERMINATED
}

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
  UNPAID
}

enum AssetStatus {
  ACTIVE
  MAINTENANCE
  DISPOSED
}

enum CRMType {
  DOCTOR
  CHEMIST
}

// ======================= MODELS =======================

// --- AUTH ---
model User {
  id               String       @id @default(uuid())
  name             String
  email            String       @unique
  phone            String?
  password         String
  role             UserRole     @default(RSM)
  lastLogin        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  auditLogs        AuditLog[]
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  module    String
  recordId  String?
  oldData   Json?
  newData   Json?
  ip        String?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

// --- PURCHASE ---
model Vendor {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  balance        Decimal   @db.Decimal(14,2) @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  purchaseOrders PurchaseOrder[]
  quotations     PurchaseQuotation[]
}

model PurchaseQuotation {
  id          String   @id @default(uuid())
  code        String   @unique
  vendorId    String
  date        DateTime
  validUntil  DateTime?
  status      POStatus @default(DRAFT)
  totalAmount Decimal  @db.Decimal(14,2) @default(0)
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  items       PQItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PQItem {
  id                  String            @id @default(uuid())
  purchaseQuotationId String
  productId           String
  quantity            Decimal           @db.Decimal(12,3)
  price               Decimal           @db.Decimal(14,2)
  purchaseQuotation   PurchaseQuotation @relation(fields: [purchaseQuotationId], references: [id])
  product             Product           @relation(fields: [productId], references: [id])
}

model PurchaseRequisition {
  id          String   @id @default(uuid())
  code        String   @unique
  date        DateTime
  requestedBy String
  status      POStatus @default(DRAFT)
  items       PRItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PRItem {
  id                    String              @id @default(uuid())
  purchaseRequisitionId String
  productId             String
  quantity              Decimal             @db.Decimal(12,3)
  purchaseRequisition   PurchaseRequisition @relation(fields: [purchaseRequisitionId], references: [id])
  product               Product             @relation(fields: [productId], references: [id])
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  code        String   @unique
  vendorId    String
  date        DateTime
  status      POStatus @default(DRAFT)
  totalAmount Decimal  @db.Decimal(14,2) @default(0)
  paidAmount  Decimal  @db.Decimal(14,2) @default(0)
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  items       POItem[]
  payments    PurchasePayment[]
  returns     PurchaseReturn[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model POItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Decimal       @db.Decimal(12,3)
  price           Decimal       @db.Decimal(14,2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])
}

model PurchasePayment {
  id              String        @id @default(uuid())
  purchaseOrderId String
  date            DateTime
  amount          Decimal       @db.Decimal(14,2)
  method          String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PurchaseReturn {
  id              String        @id @default(uuid())
  purchaseOrderId String
  date            DateTime
  reason          String?
  amount          Decimal       @db.Decimal(14,2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// --- SALES ---
model Customer {
  id           String         @id @default(uuid())
  code         String         @unique
  name         String
  type         String?
  area         String?
  mpoId        String?
  phone        String?
  address      String?
  creditLimit  Decimal        @db.Decimal(14,2) @default(0)
  balance      Decimal        @db.Decimal(14,2) @default(0)
  invoices     SalesInvoice[]
  quotations   SalesQuotation[]
  collections  Collection[]
  returns      SalesReturn[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model SalesQuotation {
  id          String   @id @default(uuid())
  code        String   @unique
  customerId  String
  date        DateTime
  status      InvoiceStatus @default(DRAFT)
  totalAmount Decimal       @db.Decimal(14,2) @default(0)
  customer    Customer      @relation(fields: [customerId], references: [id])
  items       SQItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model SQItem {
  id               String         @id @default(uuid())
  salesQuotationId String
  productId        String
  quantity         Decimal        @db.Decimal(12,3)
  price            Decimal        @db.Decimal(14,2)
  salesQuotation   SalesQuotation @relation(fields: [salesQuotationId], references: [id])
  product          Product        @relation(fields: [productId], references: [id])
}

model SalesInvoice {
  id              String        @id @default(uuid())
  code            String        @unique
  customerId      String
  date            DateTime
  status          InvoiceStatus @default(DRAFT)
  totalAmount     Decimal       @db.Decimal(14,2) @default(0)
  collectedAmount Decimal       @db.Decimal(14,2) @default(0)
  customer        Customer      @relation(fields: [customerId], references: [id])
  items           InvoiceItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model InvoiceItem {
  id             String       @id @default(uuid())
  salesInvoiceId String
  productId      String
  quantity       Decimal      @db.Decimal(12,3)
  price          Decimal      @db.Decimal(14,2)
  discount       Decimal      @db.Decimal(14,2) @default(0)
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])
}

model Collection {
  id           String    @id @default(uuid())
  customerId   String
  date         DateTime
  amount       Decimal   @db.Decimal(14,2)
  method       String
  customer     Customer  @relation(fields: [customerId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model DeliverySchedule {
  id        String   @id @default(uuid())
  invoiceId String
  date      DateTime
  vehicleNo String?
  driver    String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalesReturn {
  id          String       @id @default(uuid())
  customerId  String
  date        DateTime
  reason      String?
  amount      Decimal      @db.Decimal(14,2)
  items       ReturnItem[]
  customer    Customer     @relation(fields: [customerId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ReturnItem {
  id            String      @id @default(uuid())
  salesReturnId String
  productId     String
  quantity      Decimal     @db.Decimal(12,3)
  salesReturn   SalesReturn @relation(fields: [salesReturnId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])
}

model SalesTarget {
  id        String   @id @default(uuid())
  userId    String
  month     Int
  year      Int
  amount    Decimal  @db.Decimal(14,2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- INVENTORY ---
model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Warehouse {
  id             String          @id @default(uuid())
  name           String          @unique
  location       String?
  stockLedgers   StockLedger[]
  transfersFrom  StockTransfer[] @relation("FromWarehouse")
  transfersTo    StockTransfer[] @relation("ToWarehouse")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Product {
  id             String        @id @default(uuid())
  sku            String        @unique
  name           String
  categoryId     String
  barcode        String?       @unique
  reorderLevel   Decimal       @db.Decimal(12,3) @default(0)
  price          Decimal       @db.Decimal(14,2) @default(0)
  category       Category      @relation(fields: [categoryId], references: [id])
  prItems        PRItem[]
  poItems        POItem[]
  invoiceItems   InvoiceItem[]
  returnItems    ReturnItem[]
  stockLedgers   StockLedger[]
  stockTransfers StockTransfer[]
  stockAudits    StockAudit[]
  bomItems       BOMItem[]
  pqItems        PQItem[]
  sqItems        SQItem[]
  itemSources    ItemSource[]
  boms           BOM[]         @relation("FinishedProduct")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model StockLedger {
  id          String        @id @default(uuid())
  productId   String
  warehouseId String
  type        StockMoveType
  quantity    Decimal       @db.Decimal(12,3)
  balance     Decimal       @db.Decimal(12,3)
  reference   String?
  date        DateTime      @default(now())
  product     Product       @relation(fields: [productId], references: [id])
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
}

model StockTransfer {
  id             String    @id @default(uuid())
  productId      String
  fromWarehouseId String
  toWarehouseId   String
  quantity       Decimal   @db.Decimal(12,3)
  status         String    @default("PENDING")
  date           DateTime  @default(now())
  product        Product   @relation(fields: [productId], references: [id])
  fromWarehouse  Warehouse @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse    Warehouse @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
}

model StockAdjustment {
  id        String   @id @default(uuid())
  productId String
  quantity  Decimal  @db.Decimal(12,3)
  reason    String
  date      DateTime @default(now())
}

model QualityCheck {
  id        String   @id @default(uuid())
  reference String
  productId String
  qtyTotal  Decimal  @db.Decimal(12,3)
  qtyPass   Decimal  @db.Decimal(12,3)
  qtyFail   Decimal  @db.Decimal(12,3)
  result    QAResult
  remarks   String?
  date      DateTime @default(now())
}

model StockAudit {
  id             String   @id @default(uuid())
  productId      String
  warehouseId    String
  systemQuantity Decimal  @db.Decimal(12,3)
  actualQuantity Decimal  @db.Decimal(12,3)
  difference     Decimal  @db.Decimal(12,3)
  date           DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id])
}

// --- ACCOUNTING ---
model Account {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  type        AccountType
  parentId    String?
  parent      Account?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    Account[]   @relation("AccountHierarchy")
  journalLines JournalLine[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model CostCenter {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JournalEntry {
  id          String       @id @default(uuid())
  voucherNo   String       @unique
  date        DateTime
  type        JVType
  status      JVStatus     @default(DRAFT)
  description String?
  totalDebit  Decimal      @db.Decimal(14,2)
  totalCredit Decimal      @db.Decimal(14,2)
  lines       JournalLine[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Decimal      @db.Decimal(14,2) @default(0)
  credit         Decimal      @db.Decimal(14,2) @default(0)
  description    String?
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  account        Account      @relation(fields: [accountId], references: [id])
}

model Budget {
  id        String       @id @default(uuid())
  year      Int
  name      String
  lines     BudgetLine[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model BudgetLine {
  id        String  @id @default(uuid())
  budgetId  String
  accountId String
  amount    Decimal @db.Decimal(14,2)
  budget    Budget  @relation(fields: [budgetId], references: [id])
}

model Expense {
  id          String   @id @default(uuid())
  date        DateTime
  accountId   String
  amount      Decimal  @db.Decimal(14,2)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- HR ---
model Department {
  id        String     @id @default(uuid())
  name      String     @unique
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Employee {
  id            String     @id @default(uuid())
  empId         String     @unique
  name          String
  departmentId  String
  status        EmpStatus  @default(ACTIVE)
  joinDate      DateTime
  basicSalary   Decimal    @db.Decimal(14,2)
  department    Department @relation(fields: [departmentId], references: [id])
  documents     EmployeeDoc[]
  attendances   Attendance[]
  leaves        Leave[]
  payrolls      Payroll[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model EmployeeDoc {
  id         String   @id @default(uuid())
  employeeId String
  title      String
  url        String
  employee   Employee @relation(fields: [employeeId], references: [id])
  createdAt  DateTime @default(now())
}

model Attendance {
  id         String   @id @default(uuid())
  employeeId String
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model Leave {
  id         String    @id @default(uuid())
  employeeId String
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  status     String    @default("PENDING")
  employee   Employee  @relation(fields: [employeeId], references: [id])
}

model Payroll {
  id         String   @id @default(uuid())
  employeeId String
  month      Int
  year       Int
  basic      Decimal  @db.Decimal(14,2)
  allowances Decimal  @db.Decimal(14,2) @default(0)
  deductions Decimal  @db.Decimal(14,2) @default(0)
  netSalary  Decimal  @db.Decimal(14,2)
  isPaid     Boolean  @default(false)
  employee   Employee @relation(fields: [employeeId], references: [id])
  
  @@unique([employeeId, month, year])
}

model SalaryIncrement {
  id         String   @id @default(uuid())
  employeeId String
  date       DateTime
  amount     Decimal  @db.Decimal(14,2)
}

model Bonus {
  id         String   @id @default(uuid())
  employeeId String
  date       DateTime
  amount     Decimal  @db.Decimal(14,2)
  reason     String
}

// --- PRODUCTION ---
model BOM {
  id               String            @id @default(uuid())
  finishedProductId String
  name             String
  items            BOMItem[]
  productionOrders ProductionOrder[]
  finishedProduct  Product           @relation("FinishedProduct", fields: [finishedProductId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model BOMItem {
  id        String  @id @default(uuid())
  bomId     String
  productId String
  quantity  Decimal @db.Decimal(12,3)
  bom       BOM     @relation(fields: [bomId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model ProductionOrder {
  id          String           @id @default(uuid())
  bomId       String
  plannedQty  Decimal          @db.Decimal(12,3)
  producedQty Decimal          @db.Decimal(12,3) @default(0)
  status      ProductionStatus @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  bom         BOM              @relation(fields: [bomId], references: [id])
  steps       ProductionStep[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductionStep {
  id                String          @id @default(uuid())
  productionOrderId String
  stepName          String
  status            String          @default("PENDING")
  completedAt       DateTime?
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
}

// --- ASSET ---
model Asset {
  id                String             @id @default(uuid())
  code              String             @unique
  name              String
  category          String
  purchaseDate      DateTime
  purchaseValue     Decimal            @db.Decimal(14,2)
  currentValue      Decimal            @db.Decimal(14,2)
  depreciationRate  Decimal            @db.Decimal(5,2)
  status            AssetStatus        @default(ACTIVE)
  maintenances      AssetMaintenance[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model AssetMaintenance {
  id          String   @id @default(uuid())
  assetId     String
  date        DateTime
  cost        Decimal  @db.Decimal(14,2)
  description String
  asset       Asset    @relation(fields: [assetId], references: [id])
}

// --- CRM ---
model CRMContact {
  id        String     @id @default(uuid())
  type      CRMType
  name      String
  phone     String?
  area      String?
  mpoId     String?
  visits    CRMVisit[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CRMVisit {
  id            String     @id @default(uuid())
  contactId     String
  date          DateTime
  notes         String?
  nextVisitDate DateTime?
  contact       CRMContact @relation(fields: [contactId], references: [id])
  createdAt     DateTime   @default(now())
}

// --- ADDITIONAL SRS MODELS ---

model Project {
  id          String   @id @default(uuid())
  name        String
  budget      Decimal  @db.Decimal(14,2)
  spent       Decimal  @db.Decimal(14,2) @default(0)
  progress    Decimal  @db.Decimal(5,2) @default(0)
  status      String   @default("PLANNED")
  startDate   DateTime @default(now())
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventoryRequest {
  id          String   @id @default(uuid())
  itemId      String
  quantity    Decimal  @db.Decimal(12,3)
  requestedBy String
  date        DateTime @default(now())
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GateLog {
  id          String   @id @default(uuid())
  type        String   // IN / OUT
  vehicleNo   String
  driverName  String
  purpose     String
  time        DateTime @default(now())
  status      String   @default("LOGGED")
  createdAt   DateTime @default(now())
}

model ItemSource {
  id          String   @id @default(uuid())
  productId   String
  source      String
  reliability String
  problems    String?
  lastAudit   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id])
  createdAt   DateTime @default(now())
}

model HRPolicy {
  id          String   @id @default(uuid())
  title       String
  category    String
  content     String?
  lastRevised DateTime @default(now())
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
}
